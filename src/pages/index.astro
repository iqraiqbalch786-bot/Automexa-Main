---
import MexyTel from "../components/MexyTel.astro";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import HeroGL from "../components/motion/HeroGL.astro";
import WorkReel from "../components/motion/WorkReel.astro";
import CallMexy from "../components/CallMexy.astro";
import MexyPlayer from "../components/MexyPlayer.astro";
import PlanCard from "../components/PlanCard.astro";
import ToolLoop from "../components/ToolLoop.astro";
import Faq from "../components/Faq.astro";
import ResultsStrip from "../components/ResultsStrip.astro";
import Assurance from "../components/Assurance.astro";
import Proof from "../components/Proof.astro";
import { services, process, plans, faqs, company } from "../data/site";
import { faqLd } from "../lib/ld";
import { moneyText } from "../lib/currency.mjs";
import CurrencySwitch from "../components/CurrencySwitch.astro";
// Hero headline, pre-split on the server so the reveal needs no JS and the H1 paints at first frame (LCP).
const heroText = [..."Win more customers from your site, Google and".split(" ").map((t) => ({ t, acc: false })), { t: "every", acc: true }, { t: "call.", acc: true }];
const growth = services.filter((s) => s.slug !== "mexy");
const featured = plans;
// Scroll-lit manifesto: [text, kind] where kind "k" = gold keyword, "p" = inline mono pill.
const manifesto: [string, string?][] = [
  ["We find the lever that grows you fastest"], ["calls, site, search or admin", "p"], ["and fix that first. You get"], ["one fixed fee", "k"], ["in writing, a"], ["live preview", "p"], ["every week, and"], ["full ownership", "k"], ["at launch."],
];
---
<Base
  title="Automexa: websites, SEO and AI that win more customers"
  description="We build the website, Google rankings, ads, AI receptionist and automations that win you more customers. Fixed prices in writing. You own everything."
  jsonLd={[
    { "@context": "https://schema.org", "@type": "WebSite", name: "Automexa", url: "https://automexa.co.uk/" },
    faqLd(faqs.general),
  ]}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/hero/gl-poster-desktop.webp" type="image/webp" media="(min-width: 761px)" fetchpriority="high" />
    <link rel="preload" href="/fonts/playfair-italic.woff2" as="font" type="font/woff2" crossorigin />
  </Fragment>

  <!-- HERO: real-time WebGL liquid gold (poster still = LCP + static fallback) behind an outcome H1 -->
  <section class="hero" aria-labelledby="hero-h" data-hero data-gl="hero">
    <HeroGL />
    <div class="hero-meta wrap" aria-hidden="true"><span>Automexa · Growth partner</span><span>Websites · Search · Ads · AI</span></div>
    <div class="wrap hero-in">
      <h1 class="h-hero hero-h" id="hero-h" aria-label={heroText.map((w) => w.t).join(" ")}>{heroText.map((w, i) => <Fragment><span class="sw" aria-hidden="true">{w.acc ? <span class="acc"><span class="swi" style={`--w:${i}`}>{w.t}</span></span> : <span class="swi" style={`--w:${i}`}>{w.t}</span>}</span>{" "}</Fragment>)}</h1>
      <p class="hero-sub">You run an established business and you're ready to scale. We build the website, rankings, ads and AI receptionist that bring buyers in, then automate the admin behind them.</p>
      <Assurance class="hero-assure" />
      <div class="actions hero-actions">
        <a class="btn btn-primary btn-lg" href="/contact/" data-track="cta_click" data-loc="hero"><span>Get my fixed-price plan</span><Icon name="arrowRight" class="arrow" /></a>
        <a class="btn btn-ghost btn-lg" href="#work" data-track="show_work_click" data-loc="hero"><span>See client work</span><Icon name="arrowRight" class="arrow down" /></a>
      </div>
      <Proof class="hero-proof" />
    </div>
    <span class="hero-cue" aria-hidden="true"><i></i>Scroll</span>
  </section>

  <!-- SHOWCASE: four immersive project cards, pinned horizontal reel on desktop -->
  <WorkReel />

  <!-- RESULTS: across client projects (never attributed to a single client) -->
  <div data-gl="hide"><ResultsStrip /></div>

  <!-- SERVICES -->
  <section class="section" aria-labelledby="svc-h" data-gl="right">
    <div class="wrap">
      <div class="sec-top">
        <div class="section-head">
          <p class="marker">What we grow</p>
          <h2 class="h2" id="svc-h">Pick the result you <span class="acc">need</span> first.</h2>
        </div>
        <p class="sec-aside muted">Start where you lose the most customers. Add more when it pays for itself.</p>
      </div>
      <ul class="svc-grid" role="list">
        {growth.map((s, k) => (
          <li class="svc" data-spotlight data-reveal style={`--d:${k * 60}ms`}>
            <div class="svc-top"><span class="icon-tile accent"><Icon name={s.icon} /></span><span class="svc-price mono" set:html={s.priceFrom.startsWith("Quote") ? "Quote after call" : moneyText(`From ${s.priceFrom}`)} /></div>
            <h3 class="h3"><a href={s.href}>{s.outcome}</a></h3>
            <p class="svc-name mono">{s.name}</p>
            <ul class="points" role="list">{s.points.map((p) => <li><Icon name="check" /><span>{p}</span></li>)}</ul>
            <Icon name="arrowUpRight" class="svc-go" />
          </li>
        ))}
      </ul>
      <ToolLoop />
    </div>
  </section>

  <!-- Mobile-only WebGL interlude: the sculpted mark gets the screen between sections (hidden without live WebGL) -->
  <div class="gl-interlude" data-gl="interlude" aria-hidden="true" data-pagefind-ignore><span class="gl-fig">Fig. 01 · The Automexa mark</span></div>

  <!-- FEATURED PRODUCT: Mexy (the only green on the page) -->
  <section class="section mexy-scope mexy" aria-labelledby="mexy-h" id="mexy" data-gl="hide">
    <div class="wrap mexy-grid">
      <div>
        <p class="marker">Featured product</p>
        <h2 class="h2" id="mexy-h">Mexy answers every call, <span class="acc">24/7.</span></h2>
        <p class="lead">Our AI receptionist answers as your business, books the job and sends you a summary.</p>
        <ul class="points mexy-points" role="list">
          <li><Icon name="phoneIn" /><span>Answers on the first ring, 24/7</span></li>
          <li><Icon name="calendarCheck" /><span>Qualifies callers and books them in</span></li>
          <li><Icon name="bell" /><span>Sends you a summary of every call</span></li>
        </ul>
        <div class="mexy-links">
          <a class="link-arrow" href="/mexy/">How Mexy works <Icon name="arrowRight" /></a>
          <a class="link-arrow" href="/missed-call-calculator/">What missed calls cost you <Icon name="arrowRight" /></a>
        </div>
      </div>
      <div class="mexy-card">
        <p class="mono mc-k">Live demo line</p>
        <MexyTel class="mc-num" loc="mexy_section" />
        <p class="mc-note"><MexyTel loc="mexy_section" show="note" /></p>
        <CallMexy location="mexy_section" showSub={false} />
        <MexyPlayer />
        <div class="mc-wish">
          <Icon name="sparkle" />
          <p><strong>Want Mexy as a self-serve app?</strong> It launches at {company.wishlistTarget.toLocaleString("en-GB")} sign-ups. <a href={company.wishlistUrl} data-track="wishlist_click" data-loc="home_mexy" rel="noopener">Join the wishlist</a></p>
        </div>
      </div>
    </div>
  </section>

  <div class="gl-interlude" data-gl="explode" aria-hidden="true" data-pagefind-ignore><span class="gl-fig">Fig. 02 · Exploded view</span></div>

  <!-- PROCESS: words light up as you scroll (CSS scroll timeline, progressive) -->
  <section class="section how" aria-labelledby="how-h" data-gl="big">
    <div class="wrap">
      <div class="how-pin" data-manifesto-pin>
      <p class="marker">How we work</p>
      <h2 class="h2 how-h" id="how-h">From first call to launch in <span class="acc">four steps.</span></h2>
      <p class="manifesto" data-manifesto>
        {manifesto.map(([t, k]) => k === "p" ? <Fragment><span class="mf-pill mono">{t}</span>{" "}</Fragment> : k === "k" ? <Fragment><span class="mf-k">{t}</span>{" "}</Fragment> : t.split(" ").map((w) => <span class="mf-w">{w} </span>))}
      </p>
      </div>
      <ol class="steps" role="list">
        {process.map((p, k) => (
          <li class="step" data-reveal style={`--d:${k * 80}ms`}>
            <span class="step-n mono" aria-hidden="true">{p.step}</span>
            <span class="icon-tile"><Icon name={p.icon} /></span>
            <h3 class="h3">{p.title}</h3>
            <p class="muted">{p.text}</p>
            <span class="pill">{p.tag}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PRICING TEASER -->
  <section class="section" aria-labelledby="price-h" data-gl="left">
    <div class="wrap">
      <div class="sec-top">
        <div class="section-head">
          <p class="marker">Pricing</p>
          <h2 class="h2" id="price-h">Know the price <span class="acc">before</span> you start.</h2>
        </div>
        <div class="sec-aside"><p class="muted" set:html={moneyText("Fixed fees in {{cur}}{{gbp: plus VAT}}, and 50% books your slot. Ads, SEO and AEO/GEO are quoted after a free call.")} /><CurrencySwitch id="cur-home" /></div>
      </div>
      <div class="grid grid-3">{featured.map((p) => <PlanCard plan={p} />)}</div>
      <p class="center more"><a class="link-arrow" href="/pricing/">See all pricing <Icon name="arrowRight" /></a></p>
    </div>
  </section>

  <div data-gl="faq"><Faq items={faqs.general} title="Before you book" /></div>
  <div class="gl-interlude" data-gl="finale" aria-hidden="true" data-pagefind-ignore><span class="gl-fig">Fig. 03 · Reassembled</span></div>
</Base>

<style>
  /* Hero ----------------------------------------------------------------- */
  .hero { position: relative; isolation: isolate; margin-top: calc(-1 * var(--header-h)); min-height: max(640px, 100svh); display: flex; align-items: flex-end; padding: calc(var(--header-h) + 40px) 0 clamp(64px, 9vh, 112px); overflow: hidden; }
  /* Phones: the gold body gets the top of the screen; the headline starts below it and the main CTA stays above the fold. */
  @media (max-width: 1023px), (max-aspect-ratio: 9/10) { .hero { min-height: calc(100svh + 200px); } }
  .hero-in { display: grid; gap: clamp(18px, 2.4vw, 26px); justify-items: start; }
  .hero .h-hero { max-width: 12ch; text-shadow: 0 2px 30px rgb(0 0 0 / 0.35); }
  .hero .h-hero .acc { color: var(--gold-bright); display: inline-block; }
  .hero-sub { font-size: var(--fs-lead); font-weight: 400; letter-spacing: -0.005em; line-height: 1.5; color: var(--ink-2); max-width: 46ch; text-transform: none; text-wrap: pretty; }
  .hero-actions { gap: 12px; }
  .hero-assure { margin-top: 4px; }
  .hero .h-hero { max-width: 16ch; }
  .hero-proof { font-size: 0.86rem; }
  @media (max-width: 520px) { .hero-actions .btn { --btn-h: 54px; padding: 0 20px; font-size: 1rem; } .hero-actions { gap: 10px; } }
  .hero :global(.arrow.down) { transform: rotate(90deg); }
  .hero .btn:hover :global(.arrow.down) { transform: rotate(90deg) translateX(3px); }
  @media (min-width: 1100px) { .hero .h-hero { font-size: clamp(5rem, 6.4vw, 7.2rem); } }
  @media (prefers-reduced-motion: no-preference) {
    .hero-in > * { animation: rise 900ms var(--ease) both; }
    .hero-in > :nth-child(2) { animation-delay: 90ms; }
    .hero-in > :nth-child(3) { animation-delay: 180ms; }
    @keyframes rise { from { opacity: 0; transform: translateY(16px); } }
    /* H1 is the text LCP fallback: never hide it, only nudge it. */
    .hero-in > h1 { animation-name: nudge; }
    @keyframes nudge { from { transform: translateY(10px); } }
  }

  /* Section tops: heading left, short aside right (titi.re rhythm). */
  .sec-top { display: grid; gap: 16px; margin-bottom: clamp(32px, 5vw, 60px); align-items: end; }
  .sec-top .section-head { margin: 0; }
  .sec-aside { max-width: 38ch; font-size: 0.98rem; }
  div.sec-aside { display: grid; gap: 16px; justify-items: start; }
  @media (min-width: 900px) { .sec-top { grid-template-columns: 1fr auto; } }

  /* Services ------------------------------------------------------------- */
  .svc-grid { list-style: none; padding: 0; display: grid; gap: 14px; margin-bottom: 40px; }
  @media (min-width: 720px) { .svc-grid { grid-template-columns: repeat(2, 1fr); } }
  .svc { position: relative; display: flex; flex-direction: column; gap: 12px; padding: clamp(24px, 3vw, 34px); border-radius: var(--r-xl); background: linear-gradient(180deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.012)); border: 1px solid var(--line-2); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.05); transition: border-color var(--t), transform var(--t) var(--ease); }
  .svc:hover { border-color: var(--accent-line); transform: translateY(-3px); }
  .svc-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .svc-price { font-size: 0.74rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-ink); }
  .svc .h3 { margin-top: 10px; font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.75rem); font-weight: 700; text-transform: uppercase; letter-spacing: -0.015em; line-height: 1.05; }
  .svc .h3 a { text-decoration: none; color: inherit; }
  .svc .h3 a::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .svc:has(a:focus-visible) { outline: 2px solid var(--accent-bright); outline-offset: 4px; }
  .svc .h3 a:focus-visible { outline: none; }
  .svc-name { font-size: var(--fs-xs); color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.08em; }
  .svc .points { font-size: 0.95rem; color: var(--ink-2); margin-top: 6px; }
  .svc :global(.svc-go) { position: absolute; right: 26px; bottom: 26px; width: 22px; height: 22px; color: var(--ink-3); transition: transform var(--t) var(--ease), color var(--t); }
  .svc:hover :global(.svc-go) { transform: translate(3px, -3px); color: var(--accent-ink); }

  /* Mexy (green scope) --------------------------------------------------- */
  .mexy { background: radial-gradient(60% 70% at 85% 40%, rgb(61 255 116 / 0.07), transparent 70%), var(--bg-2); border-block: 1px solid var(--line); }
  .mexy-grid { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 1000px) { .mexy-grid { grid-template-columns: 1.1fr 1fr; gap: 72px; } }
  .mexy .h2 { max-width: 15ch; margin-top: 18px; }
  .mexy .lead { margin-top: 20px; }
  .mexy-points { margin: 28px 0; font-size: 1.02rem; }
  .mexy-links { display: flex; flex-wrap: wrap; gap: 12px 28px; }
  .mexy-card { background: var(--surface); border: 1px solid var(--accent-line); box-shadow: var(--shadow-2); border-radius: var(--r-xl); padding: clamp(24px, 4vw, 40px); display: grid; gap: 16px; justify-items: start; }
  .mc-k { font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3); }
  .mc-num { font-family: var(--display); font-size: clamp(3rem, 2rem + 4vw, 4.6rem); letter-spacing: 0.01em; text-decoration: none; color: var(--ink); line-height: 0.9; font-variant-numeric: tabular-nums; }
  .mc-num:hover { color: var(--accent); }
  .mc-note { font-size: var(--fs-sm); color: var(--ink-3); margin-top: -6px; }
  .mc-wish { display: grid; grid-template-columns: 20px 1fr; gap: 10px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 0.9rem; color: var(--ink-3); width: 100%; }
  .mc-wish :global(.icon) { width: 20px; height: 20px; color: var(--accent); }
  .mc-wish strong { color: var(--ink); }
  .mc-wish a { color: var(--accent); font-weight: 560; }

  /* How we work ---------------------------------------------------------- */
  .how-h { margin-top: 18px; max-width: 18ch; }
  .manifesto { margin-top: clamp(28px, 4vw, 48px); font-size: clamp(1.4rem, 1rem + 1.8vw, 2.5rem); line-height: 1.32; letter-spacing: -0.02em; font-weight: 560; max-width: 30ch; color: var(--ink); }
  .mf-k { color: var(--accent-ink); font-family: var(--serif); font-style: italic; font-weight: 600; }
  .mf-pill { display: inline-block; font-size: 0.42em; vertical-align: 0.35em; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.45em 1em; margin: 0 0.25em; border-radius: 999px; border: 1px solid var(--accent-line); color: var(--accent-ink); line-height: 1.2; }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* Each word brightens from muted (still 7:1 contrast) to white as it crosses the viewport. */
      .mf-w { color: var(--ink-3); animation: lit linear both; }
      :global(html.motion-ready) .manifesto.is-scrub .mf-w { animation: none; color: var(--ink); }
      .mf-w:where(*) { animation-timeline: view(); animation-range: entry 60% cover 45%; }
      @keyframes lit { to { color: var(--ink); } }
    }
  }
  .steps { list-style: none; padding: 0; display: grid; gap: 14px; margin-top: clamp(40px, 6vw, 72px); }
  @media (min-width: 720px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1080px) { .steps { grid-template-columns: repeat(4, 1fr); } }
  .step { position: relative; display: grid; gap: 12px; align-content: start; justify-items: start; padding: 26px; border-radius: var(--r-lg); background: var(--surface); border: 1px solid var(--line); }
  .step-n { position: absolute; top: 22px; right: 24px; font-size: 0.74rem; letter-spacing: 0.12em; color: var(--ink-3); }
  .step .muted { font-size: 0.94rem; }
  .more { margin-top: 32px; }
</style>
