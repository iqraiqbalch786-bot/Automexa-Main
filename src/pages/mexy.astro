---
import MexyTel from "../components/MexyTel.astro";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Button from "../components/Button.astro";
import CallMexy from "../components/CallMexy.astro";
import HeroDemo from "../components/HeroDemo.astro";
import MexyPlayer from "../components/MexyPlayer.astro";
import Calculator from "../components/Calculator.astro";
import PlanCard from "../components/PlanCard.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import Assurance from "../components/Assurance.astro";
import { company, plans, faqs } from "../data/site";
import { faqLd, offerLd } from "../lib/ld";
import { moneyText } from "../lib/currency.mjs";
import CurrencySwitch from "../components/CurrencySwitch.astro";
const mexyPlans = ["mexy-crm", "enterprise"].map((id) => plans.find((p) => p.id === id)!);
const does = [
  { i: "phoneIn", t: "Answers and helps", s: "First ring, 24/7, using your services, prices, hours and areas." },
  { i: "calendarCheck", t: "Captures and books", s: "Takes the caller's name, number and need, then books a real slot in your calendar." },
  { i: "bell", t: "Keeps you in control", s: "Sends you a summary of every call and passes urgent callers straight to you." },
] as const;
---
<Base title="Mexy: AI receptionist that answers every call, 24/7" description="Mexy answers your business calls 24/7, captures every lead and books callers into your calendar. Call the live demo now. One setup fee plus a monthly fee."
  crumbs={[{ name: "Mexy AI receptionist", href: "/mexy/" }]}
  jsonLd={[
    { "@context": "https://schema.org", "@type": "Service", name: "Mexy AI receptionist", serviceType: "AI phone answering and booking", provider: { "@id": "https://automexa.co.uk/#org" }, areaServed: ["GB", "US"], offers: [offerLd("Mexy with CRM setup", "mexySetup"), offerLd("Mexy with CRM monthly", "mexyMonthly")].flat() },
    faqLd(faqs.mexy),
  ]}>
  <div class="mexy-scope">
  <section class="page-hero">
    <div class="wrap m-hero">
      <div class="m-copy">
        <p class="marker">Our product · Mexy</p>
        <h1 class="h1">Never miss another <span class="acc">customer</span> call.</h1>
        <p class="lead">Mexy answers every call, day or night, takes the caller's details and books them into your calendar.</p>
        <Assurance items={["Live demo line, call now", "Says she's AI on every call", "Fixed price, agreed in writing"]} />
        <div class="actions">
          <CallMexy location="mexy_hero" />
          <Button href="/contact/?interest=AI%20receptionist" variant="ghost" size="lg" arrow track="cta_click" location="mexy_hero">Book a free discovery call</Button>
        </div>
      </div>
      <div class="m-card dark">
        <p class="mono m-k">Call her now. She answers as Automexa.</p>
        <MexyTel class="m-num" loc="mexy_card" />
        <p class="m-note"><MexyTel loc="mexy_card" show="note" /></p>
        <MexyPlayer />
        <ul class="points m-try" role="list">
          <li><Icon name="chat" /><span>Ask what a website costs</span></li>
          <li><Icon name="calendar" /><span>Ask to book a discovery call</span></li>
          <li><Icon name="users" /><span>Ask to speak to a person</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section-tight m-out">
    <div class="wrap grid grid-3">
      {[
        { i: "phoneIn", t: "Every call answered", s: "Each caller gets a real answer on the first ring." },
        { i: "calendarCheck", t: "More booked customers", s: "Callers are booked while they're still keen." },
        { i: "coins", t: "Predictable cost", s: "24/7 cover at a fixed price, agreed before we start." },
      ].map((o, k) => (
        <div class="out" data-reveal style={`--d:${k * 80}ms`}><span class="icon-tile accent"><Icon name={o.i as any} /></span><div><h2 class="h3">{o.t}</h2><p class="muted">{o.s}</p></div></div>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="flow-h">
    <div class="wrap m-flow">
      <div class="section-head">
        <h2 class="h2" id="flow-h">From ringing phone to booked client in one call.</h2>
        <ol class="m-steps" role="list">
          <li><span class="mono">1</span><span>Calls forward to Mexy when you're busy or closed.</span></li>
          <li><span class="mono">2</span><span>She answers as your business, helps and books a slot.</span></li>
          <li><span class="mono">3</span><span>She sends you a summary and confirms the booking with the caller.</span></li>
        </ol>
      </div>
      <HeroDemo />
    </div>
  </section>

  <section class="section alt" aria-labelledby="does-h">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2" id="does-h">What Mexy handles on every call.</h2>
      </div>
      <ul class="grid grid-3 does" role="list">
        {does.map((d, k) => <li class="card" data-reveal style={`--d:${k * 60}ms`}><span class="icon-tile accent"><Icon name={d.i} /></span><h3 class="h3">{d.t}</h3><p class="muted">{d.s}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="mcalc-h">
    <div class="wrap">
      <div class="section-head">
        <p class="marker">The cost of voicemail</p>
        <h2 class="h2" id="mcalc-h">See what missed calls cost you each month.</h2>
      </div>
      <Calculator />
    </div>
  </section>

  <section class="section alt" aria-labelledby="mprice-h">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2" id="mprice-h">Set up for you, at one fixed price.</h2>
        <p class="lead" set:html={moneyText("Mexy with CRM is {{mexySetup}} setup plus {{mexyMonthly}} a month{{gbp:, plus VAT}}. Bigger or custom setups go under Enterprise.")} />
        <CurrencySwitch id="cur-mexy" />
      </div>
      <div class="grid grid-2">{mexyPlans.map((p) => <PlanCard plan={p} />)}</div>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="wish-h">
    <div class="wrap wish card">
      <span class="icon-tile accent"><Icon name="sparkle" /></span>
      <div>
        <h2 class="h3" id="wish-h">Want Mexy as a self-serve app?</h2>
        <p class="muted">Mexy launches as a monthly app at {company.wishlistTarget.toLocaleString("en-GB")} sign-ups. Joining is free and needs no card.</p>
      </div>
      <Button href={company.wishlistUrl} variant="primary" arrow track="wishlist_click" location="mexy_page">Join the wishlist</Button>
    </div>
  </section>

  <Faq items={faqs.mexy} title="Before you put Mexy on your line" id="mexy-faq" />
  <FinalCta title="Call Mexy and hear her answer." text="Ring the live demo line now, or book a free call and we'll map out how Mexy would answer for your business." />
  </div>
</Base>
<style>
  .m-hero { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 1000px) { .m-hero { grid-template-columns: 1.1fr 1fr; gap: 64px; } }
  .m-copy .h1 { max-width: 13ch; }
  .m-card { border-radius: var(--r-xl); padding: clamp(24px, 4vw, 40px); display: grid; gap: 16px; }
  .m-k { font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.07em; color: var(--on-dark-2); }
  .m-num { font-size: clamp(2.1rem, 1.5rem + 2.6vw, 3.2rem); font-weight: 650; letter-spacing: -0.04em; color: var(--on-dark); text-decoration: none; line-height: 1; font-variant-numeric: tabular-nums; }
  .m-num:hover { color: var(--accent-bright); }
  .m-note { font-size: var(--fs-sm); color: var(--on-dark-2); margin-top: -6px; }
  .m-try { font-size: 0.93rem; color: var(--on-dark-2); padding-top: 14px; border-top: 1px solid var(--dark-line); }
  .m-out { border-block: 1px solid var(--line); background: var(--surface); }
  .out { display: grid; grid-template-columns: 44px 1fr; gap: 16px; }
  .out .muted { margin-top: 4px; font-size: 0.95rem; }
  .m-flow { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 1000px) { .m-flow { grid-template-columns: 1fr 1fr; gap: 64px; } }
  .m-flow :global(.demo) { justify-self: center; }
  .m-steps { list-style: none; padding: 0; display: grid; gap: 12px; margin-top: 8px; }
  .m-steps li { display: grid; grid-template-columns: 32px 1fr; gap: 12px; align-items: center; font-size: 1.02rem; }
  .m-steps .mono { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: var(--accent-soft); color: var(--accent); border: 1px solid var(--accent-line); font-size: 0.85rem; }
  .does { list-style: none; padding: 0; }
  .does .card { display: grid; gap: 10px; align-content: start; }
  .does .muted { font-size: 0.93rem; }
  @media (max-width: 639px) { .does { grid-template-columns: 1fr 1fr; gap: 10px; } .does .card { padding: 16px; gap: 8px; } .does .h3 { font-size: 1rem; } .does .muted { font-size: 0.84rem; } }
  .wish { display: grid; gap: 16px; align-items: center; }
  @media (min-width: 860px) { .wish { grid-template-columns: 44px 1fr auto; gap: 20px; } }
</style>
