---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import Assurance from "./Assurance.astro";
import Newsletter from "./Newsletter.astro";
import CopyButton from "./ui/CopyButton.astro";
import CurrencySwitch from "./CurrencySwitch.astro";
import { company, services, officeLine, registeredLine, tradingStatement } from "../data/site";
const year = new Date().getFullYear();
const showCta = !Astro.url.pathname.startsWith("/contact");
const socialIcon = { LinkedIn: "linkedin", Instagram: "instagram", Facebook: "facebook", TikTok: "tiktok", YouTube: "youtube" } as const;
---
<footer class="site-footer dark">
  <div class="mq" aria-hidden="true" data-marquee>
    <div class="mq-track">
      {[0, 1].map(() => <span>Websites <i></i> SEO <i></i> <b>Ads</b> <i></i> AI agents <i></i> <b>Automation</b> <i></i> Growth <i></i></span>)}
    </div>
  </div>
  {showCta && <div class="f-cta wrap" data-gl="cta">
    <p class="h1">Get your fixed-price <span class="acc">growth plan.</span></p>
    <Assurance class="f-assure" />
    <a class="btn btn-primary btn-lg" href="/contact/" data-track="cta_click" data-loc="footer_cta"><span>Book my free 15-minute call</span><span class="arrow" aria-hidden="true">→</span></a>
  </div>}
  <div class="wrap">
    <div class="f-nl" data-gl="hide"><Newsletter /></div>
    <div class="f-top">
      <div class="f-brand">
        <Logo tone="light" />
        <p class="muted">We help established businesses win more customers with websites, search, ads, AI and automation.</p>
        {company.socials.length > 0 && (
          <ul class="f-social" role="list">
            {company.socials.map((s) => <li><a href={s.href} rel="noopener" target="_blank" aria-label={`Automexa on ${s.label}`}><Icon name={socialIcon[s.label as keyof typeof socialIcon]} /></a></li>)}
          </ul>
        )}
      </div>
      <nav class="f-cols" aria-label="Footer">
        <div>
          <h2 class="f-h">Services</h2>
          <ul role="list">
            {services.map((s) => <li><a href={s.href}>{s.name}</a></li>)}
            <li><a href="/pricing/">Pricing</a></li>
          </ul>
        </div>
        <div>
          <h2 class="f-h">Company</h2>
          <ul role="list">
            <li><a href="/about/">About</a></li>
            <li><a href="/work/">Work</a></li>
            <li><a href="/missed-call-calculator/">Missed-call calculator</a></li>
            <li><a href="/faq/">FAQ</a></li>
            <li><a href={company.wishlistUrl} rel="noopener">Mexy wishlist</a></li>
          </ul>
        </div>
        <div>
          <h2 class="f-h">Contact</h2>
          <ul role="list" class="f-contact">
            <li class="f-copy"><a href={`tel:${company.phone.tel}`} data-track="call_click" data-loc="footer"><Icon name="phone" />{company.phone.display}</a><CopyButton value={company.phone.intl} label="phone number" /></li>
            <li class="f-copy"><a href={`mailto:${company.email}`} data-track="email_click" data-loc="footer"><Icon name="mail" />{company.email}</a><CopyButton value={company.email} label="email address" /></li>
            <li><a href={company.whatsapp} rel="noopener" target="_blank" data-track="whatsapp_click" data-loc="footer"><Icon name="whatsapp" />WhatsApp</a></li>
            <li><a href="/contact/"><Icon name="calendar" />Book a discovery call</a></li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="f-legal">
      <p>
        <span class="f-trading">{tradingStatement}</span>
        © {year} {company.legalName}. Registered in {company.registeredIn}, company no. {company.number}.
        Office: {officeLine}. Registered office: {registeredLine}.
      </p>
      <ul role="list">
        <li><a href="/legal/privacy/">Privacy</a></li>
        <li><a href="/legal/terms/">Terms</a></li>
        <li><a href="/legal/cookies/">Cookies</a></li>
        <li><a href="/legal/ai-disclosure/">AI disclosure</a></li>
        <li><button type="button" data-consent-open>Cookie settings</button></li>
      </ul>
      <CurrencySwitch id="cur-footer" class="f-cur" label="Currency" />
    </div>
  </div>
  <div class="f-slab" aria-hidden="true"><span class="display" data-slab>Automexa</span></div>
</footer>
<script>
  const slab = document.querySelector(".f-slab");
  if (slab && "IntersectionObserver" in window) {
    new IntersectionObserver(([e]) => document.documentElement.classList.toggle("slab-in", e.isIntersecting), { threshold: 0.35 }).observe(slab);
  }
</script>

<style>
  .site-footer { padding: 0; font-size: var(--fs-sm); background: var(--bg); border-top: 1px solid var(--line); }
  .f-cta { display: grid; gap: 28px; justify-items: start; padding-block: clamp(72px, 10vw, 140px); }
  .f-cta .h1 { max-width: 14ch; }
  .site-footer > .wrap:not(.f-cta) { padding-bottom: 32px; }
  .site-footer > .wrap:first-child { padding-top: clamp(56px, 8vw, 96px); }
  /* Giant wordmark on a gold slab: the brand signs off every page. */
  /* The slab's padding (inside the overflow clip) leaves room for the glyphs' full height, so the word is never
     cropped once its rise ends; the rise itself is scrubbed to finish just before the end of the page (scenes.ts). */
  .f-slab { background: var(--gold); color: #0a0a09; overflow: hidden; padding: 2.4vw 0 2.8vw; line-height: 0; }
  .f-slab .display { display: block; font-size: 25.6vw; line-height: 0.84; text-align: center; letter-spacing: 0.005em; white-space: nowrap; }
  /* Floating chrome steps aside while the wordmark slab is on screen, so nothing sits on the brand sign-off. */
  :global(html.slab-in) :global(.to-top), :global(html.slab-in) :global(.cdock), :global(html.slab-in) :global(.chat-aside) { opacity: 0 !important; visibility: hidden !important; pointer-events: none !important; transition: opacity 0.3s ease, visibility 0s linear 0.3s !important; }
  .f-top { display: grid; gap: 40px; }
  .f-nl { margin-bottom: clamp(48px, 6vw, 72px); }
  .f-copy { display: flex; align-items: center; gap: 2px; }
  .f-brand { display: grid; gap: 16px; max-width: 34ch; align-content: start; }
  .f-social { display: flex; gap: 4px; list-style: none; padding: 0; }
  .f-social a { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; color: var(--on-dark-2); transition: color var(--t-fast), background-color var(--t-fast); }
  .f-social a:hover { color: var(--gold); background: var(--dark-3); }
  .f-social :global(.icon) { width: 20px; height: 20px; }
  .f-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 32px; }
  .f-h { font-size: var(--fs-xs); font-family: var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--on-dark-2); font-weight: 500; margin-bottom: 14px; }
  .f-cols ul { list-style: none; padding: 0; display: grid; gap: 4px; }
  .f-cols a { color: var(--on-dark); text-decoration: none; display: inline-flex; align-items: center; gap: 8px; min-height: 32px; }
  .f-cols a:hover { color: var(--gold-bright); }
  .f-contact :global(.icon) { width: 16px; height: 16px; color: var(--on-dark-2); }
  .f-legal { margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--dark-line); display: grid; gap: 16px; color: var(--on-dark-2); font-size: var(--fs-xs); line-height: 1.6; }
  .f-legal :global(.f-cur) { grid-column: 1 / -1; }
  @media (min-width: 900px) { .f-legal :global(.f-cur) { justify-self: end; } }
  .f-trading { display: block; margin-bottom: 6px; color: var(--on-dark); }
  .f-legal ul { display: flex; flex-wrap: wrap; gap: 4px 18px; list-style: none; padding: 0; }
  .f-legal a, .f-legal button { color: var(--on-dark-2); text-decoration: none; min-height: 32px; display: inline-flex; align-items: center; font-size: var(--fs-xs); }
  .f-legal a:hover, .f-legal button:hover { color: var(--ink); text-decoration: underline; }
  @media (min-width: 900px) { .f-top { grid-template-columns: 1fr 1.6fr; } .f-legal { grid-template-columns: 1.6fr 1fr; align-items: start; } .f-legal ul { justify-content: flex-end; } }
</style>
