---
/**
 * Selected-work showcase. Desktop: a gently fanned row of cards that straighten on hover/focus
 * (titi.re-inspired "fanned stack", own CSS). Mobile: a scroll-snap rail.
 * Only real facts. Clients have approved being shown.
 */
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import { projects, type Project } from "../data/site";
import mexy from "../assets/work/mexy.jpg";
import roseempire from "../assets/work/roseempire.jpg";
import msbt from "../assets/work/msbt.jpg";
import unilink from "../assets/work/unilink.jpg";
import mrahaven from "../assets/work/mrahaven.jpg";
import toybloom from "../assets/work/toybloom.jpg";
import gummytraders from "../assets/work/gummytraders.jpg";
import jtkremovals from "../assets/work/jtkremovals.jpg";
import crm from "../assets/work/crm/roseempire-os-dash.jpg";
const imgs = { mexy, roseempire, msbt, unilink, crm, mrahaven, toybloom, gummytraders, jtkremovals } as const;
interface Props { items?: Project[]; layout?: "fan" | "grid"; headingLevel?: "h2" | "h3"; }
const { items = projects.filter((p) => p.featured), layout = "fan", headingLevel = "h3" } = Astro.props;
const H = headingLevel;
---
<ul class:list={["sc", `sc-${layout}`]} role="list">
  {items.map((p, i) => (
    <li class:list={["sc-item", p.mexy && "mexy-scope"]} style={`--i:${i};--n:${items.length}`}>
      <article class="sc-card">
        <div class="sc-media" data-skeleton>
          {p.img ? (
            <Picture src={imgs[p.img]} formats={["avif", "webp"]} fallbackFormat="jpg" widths={[420, 720, 1080]} sizes="(min-width: 1100px) 340px, (min-width: 720px) 46vw, 82vw" alt={p.img === "crm" ? `${p.name}: dashboard screenshot` : `${p.name}: live site screenshot`} loading="lazy" decoding="async" />
          ) : (
            <div class="sc-ph" role="img" aria-label={`${p.name}: screenshot placeholder`}>
              <Icon name="crm" />
              <span class="mono">Placeholder</span>
              <span class="sc-ph-t">{p.placeholder}</span>
            </div>
          )}
          <span class="sc-idx mono" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <span class="sc-kind mono">{p.kind}</span>
        </div>
        <div class="sc-body">
          <H class="sc-title display"><a href={`/work/${p.slug}/`} data-track="work_click" data-loc={`showcase_${p.slug}`}>{p.name}</a></H>
          <p class="sc-line">{p.line}</p>
          <ul class="sc-tags" role="list">{p.tags.map((t) => <li class="mono">{t}</li>)}</ul>
          <p class="sc-go" aria-hidden="true">View case study <Icon name="arrowRight" /></p>
        </div>
      </article>
    </li>
  ))}
</ul>
<style>
  .sc { list-style: none; padding: 0; margin: 0; }
  .sc-card { position: relative; height: 100%; display: flex; flex-direction: column; border-radius: var(--r-xl); overflow: hidden; background: linear-gradient(180deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.015)), var(--surface); border: 1px solid var(--line-2); box-shadow: 0 30px 70px -30px rgb(0 0 0 / 0.9); transition: border-color var(--t) var(--ease), box-shadow var(--t) var(--ease); }
  .sc-media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--bg-2); border-bottom: 1px solid var(--line); }
  .sc-media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top left; transition: transform 900ms var(--ease); }
  .sc-ph { position: absolute; inset: 10px; display: grid; place-content: center; justify-items: center; gap: 8px; text-align: center; padding: 16px; border: 1.5px dashed var(--line-2); border-radius: calc(var(--r-xl) - 10px); color: var(--ink-3); background: repeating-linear-gradient(-45deg, transparent 0 10px, rgb(255 255 255 / 0.03) 10px 20px); }
  .sc-ph :global(.icon) { width: 30px; height: 30px; color: var(--accent-ink); }
  .sc-ph .mono { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--accent-ink); }
  .sc-ph-t { font-size: 0.85rem; max-width: 26ch; }
  .sc-idx, .sc-kind { position: absolute; top: 12px; padding: 5px 10px; border-radius: 999px; font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; background: rgb(10 10 9 / 0.78); color: var(--ink); border: 1px solid var(--line-2); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
  .sc-idx { left: 12px; }
  .sc-kind { right: 12px; color: var(--accent-ink); border-color: var(--accent-line); }
  .sc-body { display: grid; gap: 12px; padding: 20px 22px 22px; flex: 1; align-content: start; }
  .sc-title { font-size: clamp(2.1rem, 1.6rem + 1.4vw, 2.75rem); color: var(--ink); }
  .sc-title a { text-decoration: none; color: inherit; }
  /* Whole card is clickable via the title link's overlay; keeps one link per card for screen readers. */
  .sc-title a::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .sc-title a:focus-visible { outline: none; }
  .sc-card:has(a:focus-visible) { outline: 2px solid var(--accent-bright); outline-offset: 4px; }
  .sc-line { color: var(--ink-2); font-size: 0.95rem; line-height: 1.45; }
  .sc-tags { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 0; }
  .sc-tags li { font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; padding: 4px 9px; border-radius: 999px; border: 1px solid var(--line-2); color: var(--ink-2); }
  .sc-go { display: inline-flex; align-items: center; gap: 8px; margin-top: 4px; font-weight: 580; font-size: 0.92rem; color: var(--accent-ink); }
  .sc-go :global(.icon) { width: 18px; height: 18px; transition: transform var(--t) var(--ease); }
  .sc-card:hover { border-color: var(--accent-line); }
  .sc-card:hover .sc-go :global(.icon) { transform: translateX(4px); }
  .sc-card:hover .sc-media :global(img) { transform: scale(1.04); }

  /* Mobile: scroll-snap rail */
  .sc-fan { display: grid; grid-auto-flow: column; grid-auto-columns: min(82vw, 380px); gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 6px var(--gutter) 22px; margin-inline: calc(-1 * var(--gutter)); scroll-padding-inline: var(--gutter); scrollbar-width: thin; scrollbar-color: var(--line-2) transparent; overscroll-behavior-x: contain; }
  .sc-fan .sc-item { scroll-snap-align: start; }

  /* Desktop: fanned row (cards tilt from a shared centre, straighten on hover/focus). */
  @media (min-width: 1100px) {
    .sc-fan { grid-auto-flow: initial; grid-template-columns: repeat(var(--cols, 4), 1fr); overflow: visible; margin: 0; padding: 30px 0 10px; gap: 18px; }
    .sc-fan .sc-item { --c: calc(var(--i) - (var(--n) - 1) / 2); transform: rotate(calc(var(--c) * 2.2deg)) translateY(calc(var(--c) * var(--c) * 10px)); transform-origin: 50% 120%; transition: transform 600ms var(--ease); }
    .sc-fan .sc-item:hover, .sc-fan .sc-item:focus-within { transform: rotate(0deg) translateY(-14px); z-index: 2; }
    .sc-fan:has(.sc-item:hover) .sc-item:not(:hover) .sc-card { opacity: 0.72; }
    .sc-fan .sc-card { transition: opacity var(--t) var(--ease), border-color var(--t) var(--ease); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sc-fan .sc-item, .sc-fan .sc-item:hover, .sc-fan .sc-item:focus-within { transform: none !important; transition: none; }
    .sc-card:hover .sc-media :global(img) { transform: none; }
  }

  /* Grid layout (work index) */
  .sc-grid { display: grid; gap: 20px; }
  @media (min-width: 720px) { .sc-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .sc-grid { grid-template-columns: repeat(3, 1fr); } }
</style>
