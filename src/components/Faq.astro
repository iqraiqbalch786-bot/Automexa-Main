---
import Icon from "./Icon.astro";
import type { Faq } from "../data/site";
import { moneyText } from "../lib/currency.mjs";
interface Props { items: Faq[]; title?: string; eyebrow?: string; id?: string; }
const { items, title = "Questions, answered", eyebrow = "FAQ", id = "faq" } = Astro.props;
---
<section class="section faq" aria-labelledby={`${id}-h`}>
  <div class="wrap faq-grid">
    <div class="section-head">
      <h2 class="h2" id={`${id}-h`}>{title}</h2>
      <p class="muted">Still unsure? <a href="/contact/">Ask us directly</a>.</p>
    </div>
    <div class="faq-list">
      {items.map((f) => (
        <details class="qa">
          <summary><h3 class="q">{f.q}</h3><span class="tog" aria-hidden="true"><Icon name="plus" /></span></summary>
          <p class="a" set:html={moneyText(f.a)} />
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .faq-grid { display: grid; gap: 8px; }
  @media (min-width: 960px) { .faq-grid { grid-template-columns: 1fr 1.5fr; gap: 64px; } .faq-grid .section-head { position: sticky; top: calc(var(--header-h) + 24px); align-self: start; } }
  .faq-list { border-top: 1px solid var(--line); }
  .qa { border-bottom: 1px solid var(--line); }
  summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 22px 0; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  .q { font-size: 1.08rem; font-weight: 580; letter-spacing: -0.015em; line-height: 1.35; }
  .tog { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: var(--bg-2); flex: none; transition: transform var(--t) var(--ease), background-color var(--t-fast); }
  .tog :global(.icon) { width: 16px; height: 16px; }
  details[open] .tog { transform: rotate(45deg); background: var(--accent); color: var(--on-accent); }
  summary:hover .tog { background: var(--line-2); }
  .a { padding: 0 48px 24px 0; color: var(--ink-2); max-width: 62ch; }
  @media (prefers-reduced-motion: no-preference) { details[open] .a { animation: fadein var(--t) var(--ease); } @keyframes fadein { from { opacity: 0; transform: translateY(-4px); } } }
</style>
