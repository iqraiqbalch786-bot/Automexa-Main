---
interface Props { href?: string | null; tone?: "ink" | "light"; }
const { href = "/", tone = "ink" } = Astro.props;
const Tag = href ? "a" : "span";
---
<Tag href={href ?? undefined} class:list={["logo", `logo--${tone}`]} aria-label={href ? "Automexa home" : undefined}>
  <svg class="logo-mark" viewBox="0 0 32 32" width="30" height="30" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="9" class="logo-bg"/>
    <path d="M16 7.5 24.5 23h-17Z" fill="none" class="logo-stroke" stroke-width="2.2" stroke-linejoin="round"/>
    <path d="M12.3 17.8h7.4" class="logo-stroke" stroke-width="2.2" stroke-linecap="round"/>
    <circle cx="16" cy="7.5" r="2.4" class="logo-node"/>
  </svg>
  <span class="logo-word">Automexa</span>
</Tag>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 650; font-size: 1.13rem; letter-spacing: -0.03em; color: var(--ink); }
  .logo-bg { fill: var(--gold); }
  .logo-stroke { stroke: #0a0a09; }
  .logo-node { fill: #0a0a09; }
  .logo--light { color: var(--ink); }
  .logo-mark { flex: none; }
</style>
