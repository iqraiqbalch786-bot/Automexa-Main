---
/** One shared confirmation modal for destructive actions. Opened via confirmAction() in scripts/ui/chrome.ts. */
---
<dialog class="cdlg" aria-labelledby="cdlg-t" aria-describedby="cdlg-b" data-confirm>
  <form method="dialog">
    <p class="cdlg-t" id="cdlg-t" data-confirm-title>Are you sure?</p>
    <p class="cdlg-b" id="cdlg-b" data-confirm-body></p>
    <div class="cdlg-a">
      <button class="btn btn-ghost" value="cancel" autofocus>Cancel</button>
      <button class="btn btn-danger" value="ok" data-confirm-ok>Confirm</button>
    </div>
  </form>
</dialog>
<style>
  .cdlg { width: min(100% - 32px, 440px); margin: auto; padding: 24px; border: 1px solid var(--line-2); border-radius: 22px; background: var(--surface); color: var(--ink); box-shadow: var(--shadow-2); }
  .cdlg::backdrop { background: rgb(0 0 0 / 0.6); }
  @media (prefers-reduced-motion: no-preference) { .cdlg[open] { animation: cd-in 180ms var(--ease); } @keyframes cd-in { from { opacity: 0; transform: scale(0.97); } } }
  .cdlg-t { font-size: 1.2rem; font-weight: 650; letter-spacing: -0.015em; }
  .cdlg-b { margin-top: 8px; color: var(--ink-2); }
  .cdlg-a { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10px; margin-top: 22px; }
</style>
