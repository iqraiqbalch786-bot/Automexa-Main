---
/** Full-site search (Pagefind static index, built after `astro build`). Loaded only when the dialog first opens. */
import Icon from "../Icon.astro";
---
<dialog class="sdlg" id="site-search" aria-labelledby="sdlg-t" data-search>
  <form role="search" class="sd-form" data-search-form>
    <label for="sd-q" id="sdlg-t" class="sr-only">Search the Automexa site</label>
    <Icon name="search" class="sd-i" />
    <input id="sd-q" type="search" name="q" placeholder="Search services, pricing, Mexy…" autocomplete="off" spellcheck="false" enterkeyhint="search" data-search-input />
    <button type="button" class="sd-x" data-search-close aria-label="Close search"><Icon name="close" /></button>
  </form>
  <p class="sd-status" role="status" aria-live="polite" data-search-status>Type at least 2 letters.</p>
  <ul class="sd-res" role="list" data-search-results></ul>
  <p class="sd-hint mono"><kbd>Esc</kbd> to close · <kbd>/</kbd> to search from any page</p>
</dialog>
<style>
  .sdlg { width: min(100% - 20px, 680px); max-height: min(80vh, 720px); margin: 10vh auto auto; padding: 0; border: 1px solid var(--line-2); border-radius: 22px; background: var(--surface); color: var(--ink); box-shadow: var(--shadow-2); overflow: hidden; }
  .sdlg[open] { display: flex; flex-direction: column; }
  .sdlg::backdrop { background: rgb(0 0 0 / 0.6); backdrop-filter: blur(4px); }
  @media (prefers-reduced-motion: no-preference) { .sdlg[open] { animation: sd-in 200ms var(--ease); } @keyframes sd-in { from { opacity: 0; transform: translateY(-8px); } } }
  .sd-form { display: flex; align-items: center; gap: 10px; padding: 10px 10px 10px 18px; border-bottom: 1px solid var(--line); }
  .sd-form :global(.sd-i) { width: 20px; height: 20px; color: var(--accent-ink); flex: none; }
  .sd-form input { flex: 1; min-width: 0; height: 48px; background: transparent; border: 0; font-size: 1.1rem; outline: none; }
  .sd-form input::-webkit-search-cancel-button { display: none; }
  .sd-form:focus-within { box-shadow: inset 0 -2px 0 var(--accent); }
  .sd-x { width: 44px; height: 44px; border-radius: 999px; display: grid; place-items: center; color: var(--ink-2); transition: background-color var(--t-fast), color var(--t-fast); }
  .sd-x:hover { background: rgb(255 255 255 / 0.08); color: var(--ink); }
  .sd-x :global(.icon) { width: 20px; height: 20px; }
  .sd-status { padding: 12px 18px 4px; font-size: 0.86rem; color: var(--ink-3); }
  .sd-res { overflow-y: auto; padding: 4px 8px 8px; display: grid; gap: 2px; }
  .sd-res :global(a) { display: grid; gap: 4px; padding: 12px 12px; border-radius: 14px; text-decoration: none; transition: background-color var(--t-fast); }
  .sd-res :global(a:hover), .sd-res :global(a:focus-visible) { background: rgb(255 255 255 / 0.06); }
  .sd-res :global(.sr-t) { font-weight: 620; }
  .sd-res :global(.sr-u) { font-family: var(--mono); font-size: 0.72rem; color: var(--ink-3); }
  .sd-res :global(.sr-x) { font-size: 0.9rem; color: var(--ink-2); line-height: 1.45; }
  .sd-res :global(mark) { background: var(--accent-soft); color: var(--accent-ink); border-radius: 3px; padding: 0 2px; }
  .sd-hint { padding: 10px 18px 14px; font-size: 0.72rem; color: var(--ink-3); border-top: 1px solid var(--line); }
  .sd-hint kbd { font-family: inherit; padding: 1px 6px; border-radius: 5px; border: 1px solid var(--line-2); }
  @media (max-width: 759px) { .sd-hint { display: none; } .sdlg { margin-top: 12px; max-height: calc(100dvh - 24px); } }
</style>
