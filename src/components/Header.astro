---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { nav, company } from "../data/site";
const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---
<header class="site-header" data-header>
  <div class="bar">
    <Logo />
    <nav class="nav-desktop" aria-label="Main">
      <ul role="list">
        {nav.map((n) => <li><a href={n.href} class:list={[n.href === "/mexy/" && "is-mexy"]} aria-current={isActive(n.href) ? "page" : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>
    <div class="bar-cta">
      <a class="btn btn-primary btn-sm hide-xs" href="/contact/" data-track="cta_click" data-loc="header"><span>Book a free call</span><span class="arrow" aria-hidden="true">→</span></a>
      <button class="icon-btn" type="button" data-search-open aria-label="Search the site" title="Search (press /)"><Icon name="search" /></button>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>
        <span class="sr-only">Menu</span>
        <Icon name="menu" class="i-open" />
        <Icon name="close" class="i-close" />
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="mobile-menu" data-menu hidden>
    <nav aria-label="Mobile">
      <ul role="list">
        <li><a href="/" aria-current={path === "/" ? "page" : undefined}>Home</a></li>
        {nav.map((n) => <li><a href={n.href} aria-current={isActive(n.href) ? "page" : undefined}>{n.label}</a></li>)}
        <li><a href="/faq/">FAQ</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><button type="button" class="mm-search" data-search-open>Search</button></li>
      </ul>
    </nav>
    <div class="mm-cta">
      <a class="btn btn-primary btn-block" href="/contact/" data-track="cta_click" data-loc="menu"><span>Book a free discovery call</span></a>
      <div class="mm-contact">
        <a href={`tel:${company.phone.tel}`} data-track="call_click" data-loc="menu"><Icon name="phone" /> {company.phone.display}</a>
        <a href={company.whatsapp} data-track="whatsapp_click" data-loc="menu" rel="noopener" target="_blank"><Icon name="whatsapp" /> WhatsApp</a>
      </div>
    </div>
  </div>
</header>

<style>
  /* Floating chrome: transparent bar, glass pill nav in the centre (titi.re-like layout, own implementation). */
  .site-header { position: fixed; top: 0; left: 0; right: 0; z-index: 50; pointer-events: none; }
  .site-header > * { pointer-events: auto; }
  .bar { position: relative; height: var(--header-h); display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-inline: var(--gutter); pointer-events: none; }
  .bar > * { pointer-events: auto; }
  /* Scroll-edge: a soft dark fade appears behind the chrome once content scrolls under it. */
  .bar::before { content: ""; position: absolute; inset: 0 0 -24px; z-index: -1; pointer-events: none; background: linear-gradient(rgb(10 10 9 / 0.94), rgb(10 10 9 / 0.72) 55%, rgb(10 10 9 / 0)); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); -webkit-mask-image: linear-gradient(#000 60%, transparent); mask-image: linear-gradient(#000 60%, transparent); opacity: 0; transition: opacity var(--t) var(--ease); }
  .site-header.scrolled .bar::before { opacity: 1; }
  .nav-desktop { display: none; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); }
  .nav-desktop ul { display: flex; gap: 2px; list-style: none; padding: 5px; border-radius: 999px; background: var(--glass); border: 1px solid var(--line-2); -webkit-backdrop-filter: saturate(1.4) blur(18px); backdrop-filter: saturate(1.4) blur(18px); box-shadow: 0 12px 40px -16px rgb(0 0 0 / 0.7), inset 0 1px 0 rgb(255 255 255 / 0.06); }
  .nav-desktop a { display: block; padding: 9px 16px; border-radius: 999px; text-decoration: none; font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-2); transition: color var(--t-fast), background-color var(--t-fast); white-space: nowrap; }
  .nav-desktop a:hover { color: var(--ink); background: rgb(255 255 255 / 0.07); }
  .nav-desktop a[aria-current="page"] { color: var(--on-accent); background: var(--gold); }
  .nav-desktop a.is-mexy[aria-current="page"] { background: var(--mexy); color: var(--on-mexy); }
  .bar-cta { display: flex; align-items: center; gap: 8px; }
  .menu-btn { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 999px; background: var(--glass); border: 1px solid var(--line-2); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); }
  .menu-btn:hover, .icon-btn:hover { background: rgb(255 255 255 / 0.12); border-color: rgb(255 255 255 / 0.32); }
  .icon-btn { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 999px; background: var(--glass); border: 1px solid var(--line-2); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); transition: background-color var(--t-fast), border-color var(--t-fast); }
  .icon-btn :global(.icon) { width: 20px; height: 20px; }
  .menu-btn { transition: background-color var(--t-fast), border-color var(--t-fast); }
  .menu-btn :global(.i-close) { display: none; }
  .menu-btn[aria-expanded="true"] :global(.i-close) { display: block; }
  .menu-btn[aria-expanded="true"] :global(.i-open) { display: none; }
  .hide-xs { display: none; }
  @media (min-width: 400px) { .hide-xs { display: inline-flex; } }
  @media (min-width: 1000px) { .nav-desktop { display: block; } .menu-btn { display: none; } }
  @media (prefers-reduced-transparency: reduce) { .nav-desktop ul, .menu-btn, .icon-btn { background: var(--surface); -webkit-backdrop-filter: none; backdrop-filter: none; } }
  @media (prefers-contrast: more) { .nav-desktop ul, .menu-btn, .icon-btn { background: var(--bg); -webkit-backdrop-filter: none; backdrop-filter: none; border-color: var(--ink); } }

  .mobile-menu { position: fixed; inset: var(--header-h) 0 0 0; background: var(--bg); padding: 12px var(--gutter) calc(32px + env(safe-area-inset-bottom)); overflow-y: auto; display: flex; flex-direction: column; justify-content: space-between; gap: 32px; }
  .mobile-menu ul { list-style: none; padding: 0; }
  .mobile-menu li a { display: block; padding: 10px 0; font-family: var(--display); font-size: 2.6rem; line-height: 1; text-transform: uppercase; letter-spacing: 0.01em; text-decoration: none; border-bottom: 1px solid var(--line); }
  .mobile-menu li a[aria-current="page"] { color: var(--accent-ink); }
  .mobile-menu li a, .mm-search { transition: color var(--t-fast); }
  .mobile-menu li a:hover, .mm-search:hover { color: var(--accent-ink); }
  .mm-search { display: block; width: 100%; text-align: left; padding: 10px 0; font-family: var(--display); font-size: 2.6rem; line-height: 1; text-transform: uppercase; letter-spacing: 0.01em; border-bottom: 1px solid var(--line); }
  .mm-cta { display: grid; gap: 10px; }
  .mm-contact { display: flex; gap: 20px; justify-content: center; padding-top: 8px; }
  .mm-contact a { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; font-weight: 500; color: var(--ink-2); min-height: 44px; }
  .mm-contact :global(.icon) { width: 18px; height: 18px; }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu:not([hidden]) { animation: mm-in var(--t) var(--ease); }
    @keyframes mm-in { from { opacity: 0; transform: translateY(-8px); } }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]")!;
  const btn = header.querySelector<HTMLButtonElement>("[data-menu-btn]")!;
  const menu = header.querySelector<HTMLElement>("[data-menu]")!;
  const main = document.getElementById("main");
  const footer = document.querySelector("footer");
  const setOpen = (open: boolean) => {
    btn.setAttribute("aria-expanded", String(open));
    menu.hidden = !open;
    header.classList.toggle("menu-open", open);
    document.documentElement.classList.toggle("menu-open", open);
    document.documentElement.style.overflow = open ? "hidden" : "";
    [main, footer, document.querySelector("[data-mobilebar]")].forEach((el) => el && ((el as HTMLElement).inert = open));
    if (open) menu.querySelector<HTMLElement>("a")?.focus();
  };
  btn.addEventListener("click", () => setOpen(btn.getAttribute("aria-expanded") !== "true"));
  menu.querySelector(".mm-search")?.addEventListener("click", () => setOpen(false));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !menu.hidden) { setOpen(false); btn.focus(); } });
  matchMedia("(min-width: 1000px)").addEventListener("change", (e) => e.matches && setOpen(false));
  // Scrolled state without a scroll listener or a forced layout read: watch a sentinel at the top of the page.
  const sentinel = document.createElement("div");
  sentinel.setAttribute("aria-hidden", "true");
  sentinel.style.cssText = "position:absolute;top:0;left:0;width:1px;height:24px;pointer-events:none";
  document.body.prepend(sentinel);
  new IntersectionObserver(([e]) => header.classList.toggle("scrolled", !e.isIntersecting)).observe(sentinel);
</script>
