# ---- Public (baked into the static build) ----
PUBLIC_SITE_URL=https://automexa.co.uk
# Where the forms POST. Same-origin on Netlify. If the static site is hosted elsewhere (e.g. GoDaddy),
# point this at the deployed function URL, e.g. https://automexa-preview.netlify.app/api/lead
PUBLIC_LEAD_ENDPOINT=/api/lead
# Analytics (consent-gated). Leave empty to disable. Use ONE of these.
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_GA4_ID=
# Optional Cloudflare Turnstile site key (forms show the widget only when set)
PUBLIC_TURNSTILE_SITE_KEY=
# Optional booking link (Cal.com / Calendly). When set, the contact page offers it next to the form.
PUBLIC_BOOKING_URL=
# Set to "true" only for non-production previews (adds noindex)
PUBLIC_NOINDEX=false

# ---- Server (Netlify Function env only, never in the build) ----
SUPABASE_URL=https://ctqghaphmqqiclaniwqm.supabase.co
SUPABASE_PUBLISHABLE_KEY=
LEAD_INGEST_TOKEN=
LEAD_IP_SALT=
ALLOWED_ORIGINS=https://automexa.co.uk,https://www.automexa.co.uk
RESEND_API_KEY=
LEAD_NOTIFY_FROM=Automexa website <leads@automexa.co.uk>
LEAD_NOTIFY_TO=info@automexa.co.uk
TURNSTILE_SECRET_KEY=
